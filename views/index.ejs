<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <!-- defer runs the script after the page's form elements have been created. -->
  <script src="/javascripts/customer.js" defer></script>
</head>
<body>
<h1><%= title %></h1>
<p>Welcome to <%= title %>.   Let's test reading get+post data</p>

<br/><br/>
<b>New Customer Form </b> to test POST request and reading data using URI /readCustomerInfoAndRespond
<br/>
<form action="/readCustomerInfoAndRespond" method="post">

  Name: <input type="text" name="name"> </input>
  <br/>
  Email: <input type="text" name="email"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>

<br><br><br>
<hr>

<!-- The original form above navigates to an HTML response.
     This second form uses JavaScript to display the API response on this page. -->
<h2>REST / JSON Customer Form</h2>
<p>Send the same customer information and see the response without a page reload.</p>
<form id="api-customer-form">
  <label for="customer-name">Name:</label>
  <input id="customer-name" type="text" name="name" required>
  <br>
  <label for="customer-email">Email:</label>
  <input id="customer-email" type="email" name="email" required>
  <br>
  <button id="customer-submit" type="submit">Send with fetch</button>
</form>
<!-- Announce the loading state, response, or error without navigating away. -->
<p id="customer-result" role="status" aria-live="polite" style="white-space: pre-line;"></p>
<hr>

<b>Form to test GET request</b> and reading the data using URI /readNameAndRespond
<br/>
<form action="/readNameAndRespond" method="get">

  Name: <input type="text" name="name"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>
<br><br><br>
<hr>
<b>Form to test POST request</b> and reading data using URI  /readNameAndRespond
<br/>
<form action="/readNameAndRespond" method="post">

  Name: <input type="text" name="name"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>



</body>
</html>
